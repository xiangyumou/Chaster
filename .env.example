# API Authentication Token (required)
API_TOKEN=your_secure_token_here

# Redis 配置 (Rate Limiting)
REDIS_URL=redis://redis:6379
# Rate Limit Max (Optional, default 100). Set to 0 to disable.
RATE_LIMIT_MAX=100
# Rate Limit Window (Optional, default 60000ms = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Rate Limit Fail-Open (Optional, default false). Set to true to allow requests when Redis is unavailable.
RATE_LIMIT_FAIL_OPEN=false

# CORS Origin (Optional, default *). Set to specific origin for production.
CORS_ORIGIN=*

# Drand Chain URL (Optional, defaults to Quicknet)
DRAND_CHAIN_URL=https://api.drand.sh/52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971

# App URL (Optional, used for Swagger docs)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# PostgreSQL 配置
POSTGRES_USER=chaster
POSTGRES_PASSWORD=chaster_password
POSTGRES_DB=chaster

# 数据库连接 URL（Docker 内部使用）
# Add ?connection_limit=10 for production to control connection pool size
DATABASE_URL="postgresql://chaster:chaster_password@db:5432/chaster"
